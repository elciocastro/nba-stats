# Copie para .env e preencha. O .env nunca vai para o Git.

# Fonte de dados: nba_api (grátis, só funciona da sua rede, não da nuvem)
# ou balldontlie (paga, estável, funciona de qualquer lugar)
NBASTATS_FONTE=nba_api

# Chave da BALLDONTLIE (https://app.balldontlie.io)
BALLDONTLIE_API_KEY=

# Requisições por minuto do seu plano: Free=5, ALL-STAR=60, GOAT=600
BALLDONTLIE_RPM=60

# Arquivo do banco SQLite
NBASTATS_DB=data/nba.db

# Senha do site (opcional em dev; obrigatória quando for para o ar)
NBASTATS_PASSWORD=

# Relatório BetânIAG com IA (opcional; também exige ia.habilitado: true em config/betaniag.yaml)
ANTHROPIC_API_KEY=
